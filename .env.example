# API
APP_NAME=LinguaDub AI
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=500
MAX_VIDEO_MINUTES=10

# Storage and database (relative paths resolve from backend/)
DATABASE_URL=sqlite:///../storage/linguadub.db
STORAGE_DIR=../storage

# AI provider defaults: faster-whisper, google, edge require no paid key
STT_PROVIDER=faster-whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
TRANSLATION_PROVIDER=google
TTS_PROVIDER=edge

# Optional OpenAI Whisper and Gemini translation providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional ElevenLabs TTS provider. Configure a voice ID from your account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional local Wav2Lip adapter. Requires CUDA, a local checkout, and model weights.
WAV2LIP_REPO=
WAV2LIP_CHECKPOINT=
